# LOCAL ONLY: runs a build made on the host (npx ng build), because npm cannot always be reached from inside Docker behind a
# corporate proxy. Used through the backend's deploy/local/up.ps1.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    PORT=4000 \
    API_INTERNAL_URL=http://api:8080
COPY dist/I-rieltor.uz-web ./
USER node
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:4000/healthz || exit 1
CMD ["node", "server/server.mjs"]
